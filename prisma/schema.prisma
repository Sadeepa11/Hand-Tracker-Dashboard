generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  calculations Calculation[]
  createdAt    DateTime      @default(now())
}

model Calculation {
  id         String   @id @default(cuid())
  expression String
  result     String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}
